# Server-only Supabase PostgreSQL connection string.
# Use the session-pooler URL from Supabase Project Settings > Database.
DATABASE_URL=
VTN_DATABASE_REQUIRED=1

VTN_ALLOWED_ORIGINS=http://localhost:8421,http://127.0.0.1:8421,http://localhost:8000,http://127.0.0.1:8000
VTN_SECRET=
VTN_DEMO_AUTH=1
VTN_DEMO_ALLOW_ADMIN=1
VTN_MAX_AUDIO_BYTES=10485760
